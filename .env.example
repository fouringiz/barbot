BOT_TOKEN=123456:ABC...          # от @BotFather
GROUP_ID=-1004421688859          # из ссылки на сообщение: t.me/c/4421688859/... -> -1004421688859
TOPIC_STOP=3                     # среднее число из ссылки на сообщение в топике «Стоп-лист»
TOPIC_NEEDS=4                    # то же для «Заявок»
TOPIC_SPENT=2                    # то же для «Расходов»; пусто = модуль выключен
CLOSE_TIME=02:00                 # конец бар-дня по Баку — итог дня постится в это время
SHEET_ID=1AbC...                 # из URL таблицы между /d/ и /edit
GOOGLE_CREDS_JSON={"type":"service_account", ...}   # весь JSON ключа одной строкой

# Mini App
WEB_ORIGIN=https://fouringiz.github.io   # CORS: откуда разрешены запросы к API
APP_LINK=https://t.me/bakiliBarBot/app   # прямая ссылка на Mini App после /newapp в BotFather — кнопка в /app
DEV_TOKEN=                                # любая строка: позволяет открыть фронт как ?dev=<строка> без Telegram; пусто = выключено
# PORT выставляет Railway сам (локально 8080)
