BOT_TOKEN=123456:ABC...          # от @BotFather
GROUP_ID=-1001234567890          # /id в группе или из ссылки на сообщение; можно оставить пустым до первого запуска
TOPIC_STOP=12                    # /id в топике «Стоп-лист» (0 = General)
TOPIC_NEEDS=15                   # /id в топике «Заявки»
SHEET_ID=1AbC...                 # из URL таблицы между /d/ и /edit
GOOGLE_CREDS_JSON={"type":"service_account", ...}   # весь JSON ключа одной строкой
TOPIC_SPENT=5                    # топик «Расходы» (из ссылки на сообщение); пусто = модуль выключен
CLOSE_TIME=02:00                 # конец бар-дня по Баку — в это время постится итог дня
WEB_ORIGIN=https://fouringiz.github.io   # откуда разрешены запросы к API (CORS); пусто = откуда угодно
# PORT выставляет Railway сам; локально по умолчанию 8080
